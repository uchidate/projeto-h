{
  "name": "projeto-h",
  "version": "0.0.0-semantic-release",
  "private": true,
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:file": "eslint",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:secrets": "gitleaks dir . --redact",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "security:install-scripts": "npm approve-scripts --allow-scripts-pending",
    "quality:actions": "actionlint",
    "quality:containers": "hadolint Dockerfile",
    "quality:dead-code": "knip --dependencies",
    "quality:shell": "shellcheck -S error scripts/*.sh",
    "quality:quick": "npm run lint && npm run type-check && npm run quality:containers && npm run quality:dead-code",
    "quality:check": "npm run quality:quick && npm test && npm run security:check",
    "performance:audit": "npx --yes @lhci/cli@0.15.1 autorun",
    "performance:load": "k6 run tests/load/site-smoke.js",
    "security:check": "npm run security:secrets && npm run security:code && npm run quality:shell && npm run quality:actions",
    "security:code": "bash scripts/security-semgrep.sh && bash scripts/security-trivy.sh",
    "tooling:check": "npm run quality:containers && npm run quality:dead-code && npm run security:code",
    "grafo": "graphify export html && echo \"grafo em graphify-out/ — use: graphify query \\\"<pergunta>\\\"\"",
    "grafo:atualizar": "graphify update || echo \"sem graphify-out: rode a skill /graphify primeiro\"",
    "article:check": "node scripts/check-article-structure.mjs",
    "context:check": "node scripts/check-project-context.mjs",
    "context:find": "node scripts/find-project-context.mjs",
    "context:impact": "node scripts/project-change-impact.mjs",
    "identity:check": "node scripts/check-product-identity.mjs",
    "notas:resumo": "node scripts/notas-resumo.mjs",
    "seo:check": "node scripts/check-seo-architecture.mjs",
    "seo:test": "vitest run lib/seo",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.5",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dotenv": "^17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "next-auth": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher": false,
    "@swc/core": false
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
