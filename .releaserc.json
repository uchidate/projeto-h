{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "test",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "type": "build",
            "release": "patch"
          },
          {
            "type": "revert",
            "release": "patch"
          },
          {
            "type": "ci",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "style",
            "release": false
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "Funcionalidades"
            },
            {
              "type": "fix",
              "section": "Correções"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "test",
              "section": "Testes"
            },
            {
              "type": "refactor",
              "section": "Refatoração"
            },
            {
              "type": "build",
              "section": "Build"
            },
            {
              "type": "revert",
              "section": "Reversões"
            },
            {
              "type": "ci",
              "section": "CI/CD",
              "hidden": true
            },
            {
              "type": "chore",
              "section": "Manutenção",
              "hidden": true
            },
            {
              "type": "docs",
              "section": "Documentação",
              "hidden": true
            },
            {
              "type": "style",
              "section": "Estilo",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    "@semantic-release/github"
  ]
}
